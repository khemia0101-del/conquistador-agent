# =============================================
# Conquistador Agent — Environment Variables
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- NVIDIA NIM API (required) ---
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=

# --- Zoho Mail SMTP (required for sending proposals) ---
# Create a Zoho app password: Settings > Security > App Passwords
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# --- Optional ---
NOTIFY_EMAIL=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
