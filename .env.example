# Required
NVIDIA_API_KEY=nvapi-xxxxx

# Optional overrides
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
CRAIGSLIST_REGIONS=newyork,sfbay,losangeles,chicago
SCAN_INTERVAL_MINUTES=30
AUTO_RESPOND_THRESHOLD=0.85
MAX_AUTO_RESPONSES_PER_DAY=10

# OpenAI/ChatGPT OAuth (optional - enables dual-evaluator mode)
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_REDIRECT_URI=http://localhost:8080/callback
OPENAI_MODEL=gpt-4o

# Agent's Zoho Mail account (used for sending proposals AND notifications)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=agent@yourdomain.com
SMTP_PASSWORD=your-zoho-app-password
NOTIFY_EMAIL=you@youremail.com
