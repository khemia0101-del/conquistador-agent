# === REQUIRED ===

# NVIDIA NIM API key (get one free at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxx

# Zoho Mail for the agent (the email it sends proposals from)
ZOHO_SMTP_USER=your-agent@yourdomain.com
ZOHO_SMTP_PASSWORD=your-zoho-app-password

# === OPTIONAL ===

# Your personal email (where you get notifications about borderline matches)
NOTIFY_EMAIL=you@yourpersonalemail.com

# NVIDIA model override
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
